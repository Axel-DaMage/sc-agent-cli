{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Example project-local config for SC-Agent CLI",
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "http://localhost:11434/v1",
    "model": "llama3.2",
    "temperature": 0.7,
    "maxTokens": 4096,
    "stream": true
  },
  "profiles": {
    "openai-backup": {
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "<YOUR_OPENAI_KEY>",
      "model": "gpt-4o-mini"
    }
  },
  "failover": {
    "cascade": [
      "openai-backup",
      { "baseUrl": "http://localhost:1234/v1", "model": "lmstudio-model" }
    ],
    "retry": {
      "maxRetries": 2,
      "baseDelayMs": 1000,
      "backoffMultiplier": 2,
      "maxDelayMs": 30000
    }
  },
  "permissions": {
    "autoApprove": [
      "read_file",
      "list_dir",
      "search_text"
    ],
    "denyPaths": [
      ".env",
      ".env.*",
      "**/*.key",
      "**/*.pem",
      "**/*.secret"
    ],
    "denyCommands": [
      "git push --force",
      "rm -rf /",
      "curl * | *sh"
    ]
  }
}
