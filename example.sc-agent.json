{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Example project-local config for SC-Agent CLI",
  "model": {
    "provider": "openai-compatible",
    "baseUrl": "http://localhost:11434/v1",
    "model": "llama3.2",
    "temperature": 0.7,
    "maxTokens": 4096,
    "stream": true
  },
  "roles": {
    "planner": "anthropic/claude-sonnet-4-6",
    "executor": "openai/gpt-4o-mini",
    "reviewer": "nvidia/meta/llama-3.3-70b-instruct"
  },
  "permissions": {
    "autoApprove": [
      "read_file",
      "list_dir",
      "search_text"
    ],
    "denyPaths": [
      ".env",
      ".env.*",
      "**/*.key",
      "**/*.pem",
      "**/*.secret"
    ],
    "denyCommands": [
      "git push --force",
      "rm -rf /",
      "curl * | *sh"
    ]
  }
}
