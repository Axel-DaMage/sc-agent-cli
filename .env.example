# SC CLI Environment Variables
# Copy this file to .env and fill in your API keys
# Or export these variables in your shell

# General API key (highest priority)
# SC_API_KEY="your-api-key-here"

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-your-openai-key-here"

# Anthropic API key
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-key-here"

# NVIDIA API key
# Get from: https://build.nvidia.com/
# NVIDIA_API_KEY="nvapi-your-nvidia-key-here"

# Behavior configuration
# Maximum iterations before agent stops (default: 100)
# SC_MAX_ITERATIONS=100

# Maximum storage in gigabytes for persistent data (default: 1)
# Auto-cleanup removes oldest files when limit is exceeded
# SC_MAX_STORAGE_GB=1

# Provider failover contract
# Ordered csv of "provider/model" fallback candidates tried after the
# configured model (empty = single configured model, no cascade).
# Provider names resolve against config profiles, then known provider URLs.
# SC_FAILOVER="openai/gpt-4o-mini,anthropic/claude-sonnet-4-6"

# Per-attempt timeouts (ms): connect = time to first response headers,
# attempt = total attempt deadline. Defaults: 30000 / 120000.
# SC_PROVIDER_CONNECT_TIMEOUT_MS=30000
# SC_PROVIDER_ATTEMPT_TIMEOUT_MS=120000

# Multi-model orchestration (config.roles): max executor rework rounds when
# the reviewer phase emits VERDICT: request_changes (default: 3, 0 disables).
# SC_ROLE_MAX_FIXES=3

# Injection budget for the assembled system prompt (estimated tokens).
# Over-budget sources are trimmed/dropped in priority order (memory first,
# system prompt last); trims are logged and reported in the run manifest
# context_budget block. Unset = no cap.
# SC_CONTEXT_BUDGET_TOKENS=8000

# Command executed inside the devcontainer when using --devcontainer (default: scc)
# SC_DEVCONTAINER_AGENT_CMD="scc"

# Tool-call sandboxing (docs/sandboxing.md). Force the sandbox boundary on/off
# for every run_shell call — wins over the config file's sandbox.enabled.
# SC_SANDBOX=1   # on | off | true | false | 1 | 0
# Override the global config file location (default: ~/.sc-agent/config.json)
# SC_CONFIG_PATH="/path/to/config.json"

# Note: Environment variables take precedence over config file keys
# Priority: SC_API_KEY > provider-specific keys > config file
